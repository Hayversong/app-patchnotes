# Copie para .env (raiz do projeto). Usado pelo frontend (npm run dev) e pelo docker compose da raiz.

# --- Frontend ---
# Backend para onde o Next encaminha /api/* (rewrite em next.config.mjs).
API_URL=http://localhost:8000
# WebSocket do chat. O rewrite do Next não encaminha WebSocket, então em desenvolvimento o navegador conecta direto
# no backend. Atrás de um proxy que encaminhe /ws (como o nginx do docker compose), use só o caminho: /ws/chat
NEXT_PUBLIC_CHAT_WS_URL=ws://localhost:8000/ws/chat

# --- docker compose (ambiente completo) ---
# Segredo dos JWT (mínimo 32 caracteres). Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
POSTGRES_USER=patchnotes
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=patchnotes
# Senha do Redis (limites de requisição e conexões). Use um valor aleatório; só letras, números, - e _.
REDIS_PASSWORD=troque-esta-senha-do-redis
# Modelo baixado pelo serviço ollama-pull na primeira subida (~2 GB).
OLLAMA_MODEL=qwen2.5:3b

# --- Produção (docker-compose.prod.yml) ---
# Domínio público do site (com DNS apontando para o servidor). Padrão: localhost, com certificado local.
# SITE_ADDRESS=patchnotes.seudominio.com
# SMTP real para os e-mails de confirmação e de senha (sem isso, ficam no Mailpit).
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# MAIL_FROM=Patchnotes <no-reply@seudominio.com>
