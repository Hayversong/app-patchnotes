# Copie para backend/.env e ajuste. Nunca commite o .env com valores reais.

# development | test | production. Em production: JWT_SECRET forte, COOKIE_SECURE=true e CORS explícito são obrigatórios.
ENVIRONMENT=development

# --- PostgreSQL (docker compose usa as mesmas credenciais de desenvolvimento) ---
POSTGRES_USER=patchnotes
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=patchnotes
POSTGRES_PORT=5432
# URL usada pela aplicação (driver asyncpg). Deve bater com as variáveis acima.
DATABASE_URL=postgresql+asyncpg://patchnotes:troque-esta-senha@127.0.0.1:5432/patchnotes
# Banco dos testes automatizados (é limpo a cada execução — nunca aponte para dados reais).
TEST_DATABASE_URL=postgresql+asyncpg://patchnotes:troque-esta-senha@127.0.0.1:5432/patchnotes_test
# Redis de testes (banco 15, apagado pelos testes). Opcional localmente; obrigatório na CI.
TEST_REDIS_URL=redis://127.0.0.1:6379/15

# --- Autenticação ---
# Segredo de assinatura dos JWT (mínimo 32 caracteres). Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Validade do access token em minutos. O frontend renova automaticamente via /auth/refresh quando expira.
ACCESS_TOKEN_TTL_MINUTES=15
# Validade do refresh token (cookie httpOnly, rotacionado a cada uso).
REFRESH_TOKEN_TTL_DAYS=7
# true exige HTTPS para os cookies. Obrigatório em production.
COOKIE_SECURE=false
# Origens autorizadas (CORS e WebSocket), separadas por vírgula. "*" não é aceito.
CORS_ORIGINS=http://localhost:3000
# Proxies reversos confiáveis (IPs ou CIDR, separados por vírgula). Só conexões vindas deles têm o X-Forwarded-For
# lido (da direita para a esquerda). Vazio = IP da conexão. NUNCA liste o servidor Next.js (o rewrite repassa o
# cabeçalho do cliente sem acrescentar o IP real) nem 0.0.0.0/0. Inicie a API com `python -m app`.
TRUSTED_PROXIES=
# Estado compartilhado entre réplicas: limites de requisição e de conexões WebSocket. Obrigatório em production.
# Sem ele (desenvolvimento), os limites ficam na memória do processo.
REDIS_URL=redis://127.0.0.1:6379/0
# Desativa os limites de requisição (apenas para testes).
RATE_LIMIT_ENABLED=true

# --- Recuperação de senha ---
PASSWORD_RESET_TTL_MINUTES=30
# Base do link enviado por e-mail: <FRONTEND_URL>/reset-password#token=...
FRONTEND_URL=http://localhost:3000
# SMTP. Em desenvolvimento, o Mailpit do docker compose (http://localhost:8025 para ver os e-mails).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS (porta 587) ou TLS implícito (porta 465). Use um dos dois com provedores reais.
SMTP_STARTTLS=false
SMTP_USE_TLS=false
MAIL_FROM=Patchnotes <no-reply@patchnotes.local>

# --- LLM (Ollama local) ---
# Mantenha o Ollama em 127.0.0.1 ou rede privada; não exponha a porta 11434 publicamente.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.7
# Janela de contexto (tokens) que o Ollama reserva na VRAM. 2048 cabe folgado em GPUs de 4 GB com qwen2.5:3b.
OLLAMA_NUM_CTX=2048
# Máximo de tokens gerados por resposta.
OLLAMA_MAX_OUTPUT_TOKENS=512
# Tempos limite em segundos: conexão, espera entre trechos do streaming e duração total da resposta.
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=60
OLLAMA_TOTAL_TIMEOUT=180
OLLAMA_KEEP_ALIVE=5m

# --- Chat e cota ---
# Mensagens anteriores enviadas ao modelo como contexto.
CHAT_CONTEXT_MESSAGES=6
# Cota mensal de tokens por usuário (prompt + resposta). Ao zerar, o chat responde 429.
MONTHLY_TOKEN_QUOTA=100000
